---
// StatBlock — duża liczba + etykieta. Używaj w grupach 2-4 dla "social proof".
// TYLKO PRAWDZIWE LICZBY. Nie zmyślaj statystyk — patrz playbook 06.
//
// Użycie w gridzie — przez balancedGrid (symetryczne rzędy, patrz src/lib/grid.ts):
//   const grid = balancedGrid(items.length, { mobileCols: 2, fourAcross: true });
//   <div class:list={["gap-6", grid.container]}>
//     {items.map((s, i) => (
//       <div class={grid.item(i)}><StatBlock value={s.value} label={s.label} /></div>
//     ))}
//   </div>

import { editAttrs } from "../lib/edit";

interface Props {
  value: string;
  label: string;
  hint?: string;
  accent?: boolean;
  // data-edit elementu — value/label jako edytowalne liście (patrz FeatureCard).
  editPath?: string;
}

const { value, label, hint, accent = false, editPath } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-1 border-l-2 pl-4 py-1",
    accent
      ? "border-[var(--color-accent)]"
      : "border-[var(--color-border)]",
  ]}
>
  <span
    class:list={[
      "font-serif text-[2rem] font-medium leading-none tracking-tight md:text-[2.5rem]",
      accent
        ? "text-[var(--color-accent)]"
        : "text-[var(--color-text)]",
    ]}
  >
    <span {...(editPath ? editAttrs(`${editPath}.value`) : {})}>{value}</span>
  </span>
  <span
    class="text-[0.8125rem] font-medium uppercase tracking-[0.08em] text-[var(--color-text-muted)]"
    {...(editPath ? editAttrs(`${editPath}.label`) : {})}
  >
    {label}
  </span>
  {hint && (
    <span class="text-xs text-[var(--color-text-faint)]">{hint}</span>
  )}
</div>
