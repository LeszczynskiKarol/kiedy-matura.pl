---
// Ikony profili społecznościowych klienta (template v32) — renderują się
// TYLKO ustawione wpisy siteConfig.social; wszystkie puste ⇒ komponent nie
// zostawia śladu w HTML. Inline SVG (hard rule: bez bibliotek ikon; te trzy
// to oficjalne, powszechnie rozpoznawalne glify marek — spójna kreska 24×24).
// Wartości ustawia formularz zamówienia / panel (endpoint /social) — NIE
// hardcoduj URL-i w komponencie.
import { siteConfig } from "../config/site";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const items = [
  { key: "facebook", label: "Facebook", href: siteConfig.social?.facebook },
  { key: "instagram", label: "Instagram", href: siteConfig.social?.instagram },
  { key: "tiktok", label: "TikTok", href: siteConfig.social?.tiktok },
].filter((s) => s.href);
---

{items.length > 0 && (
  <ul class={`flex items-center gap-2 ${className}`}>
    {items.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          aria-label={`${siteConfig.name} na ${s.label}`}
          class="flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] no-underline transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          {s.key === "facebook" && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.6 1.6-1.6h1.3V4.8c-.6-.1-1.4-.2-2.3-.2-2.3 0-3.9 1.4-3.9 4V11H7.5v3h2.7v7h3.3z" />
            </svg>
          )}
          {s.key === "instagram" && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
            </svg>
          )}
          {s.key === "tiktok" && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.6 3c.3 1.7 1.4 3.1 3.4 3.4v3c-1.4 0-2.6-.4-3.6-1.1v6.6c0 3.4-2.4 5.6-5.4 5.6-3 0-5.3-2.2-5.3-5.2 0-3 2.4-5.3 5.5-5.2.3 0 .6 0 .9.1v3.1a2.6 2.6 0 0 0-1-.2c-1.4 0-2.4 1-2.4 2.3 0 1.3 1 2.2 2.3 2.2 1.4 0 2.4-.9 2.4-2.6V3h3.2z" />
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
)}
