---
// Opinie z wizytówki Google — dane 1:1 ze snapshotu backendu (rating, total,
// profileUrl, 5 najnowszych opinii). NIGDY ręcznie zmyślone.
//
// ATRYBUCJA (wymóg TOS Google): napis "Opinie z Google" + link do profilu
// są HARDCODED w tym komponencie i NIE są sterowane danymi — nie usuwaj ich
// i nie przenoś do JSON-a przy customizacji per-projekt.
//
// Gwiazdki: własny inline SVG (celowo NIE z src/icons/set.ts — komponent jest
// samowystarczalny, żeby migracja szablonu nie musiała dotykać autorskiego,
// per-projektowego set.ts). Pełna/pusta wg zaokrąglonej oceny (bez połówek).
import { editAttrs } from "../../lib/edit";
import { balancedGrid } from "../../lib/grid";
import { sectionBg } from "../../lib/sections";
import type { GoogleReviewsData } from "../../content.config";

interface Props {
  data: GoogleReviewsData;
  editPath: string;
}
const { data, editPath } = Astro.props;
const grid = balancedGrid(data.reviews.length);

// Własna geometria 5-ramiennej gwiazdy na siatce 24×24 (nie kopiowana z bibliotek).
const STAR_PATH =
  "M12 3.8 14.1 9.9 20.6 10 15.4 13.9 17.3 20.1 12 16.4 6.7 20.1 8.6 13.9 3.4 10 9.9 9.9 Z";
const STARS = [1, 2, 3, 4, 5];
const avgFilled = Math.round(data.rating);
const ratingLabel = String(data.rating).replace(".", ",");
---

<section
  id={data.id}
  class:list={["border-b border-[var(--color-border)]", sectionBg(data.background)]}
  {...editAttrs(editPath)}
>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-text-faint)]">
          Opinie z Google
        </p>
        <h2
          class="mt-3 font-serif text-[length:var(--text-fs-h2)] font-medium leading-tight tracking-tight"
          {...editAttrs(`${editPath}.heading`)}
        >
          {data.heading}
        </h2>
      </div>

      <div class="shrink-0">
        <div class="flex items-center gap-3">
          <span class="font-serif text-5xl font-medium leading-none">{ratingLabel}</span>
          <div>
            <div
              class="flex gap-0.5"
              role="img"
              aria-label={`Średnia ocena ${ratingLabel} na 5`}
            >
              {STARS.map((n) => (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  aria-hidden="true"
                  class={n <= avgFilled ? "text-[var(--color-accent)]" : "text-[var(--color-border)]"}
                  fill={n <= avgFilled ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                >
                  <path d={STAR_PATH} />
                </svg>
              ))}
            </div>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">
              {data.total} opinii w Google
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class:list={["mt-12 gap-4", grid.container]}>
      {data.reviews.map((r, i) => (
        <figure
          class:list={[
            "flex flex-col gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6",
            grid.item(i),
          ]}
          
        >
          <div class="flex items-center justify-between gap-3">
            <div
              class="flex gap-0.5"
              role="img"
              aria-label={`Ocena ${r.rating} na 5`}
            >
              {STARS.map((n) => (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  aria-hidden="true"
                  class={n <= Math.round(r.rating) ? "text-[var(--color-accent)]" : "text-[var(--color-border)]"}
                  fill={n <= Math.round(r.rating) ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                >
                  <path d={STAR_PATH} />
                </svg>
              ))}
            </div>
            <span class="text-xs text-[var(--color-text-faint)]" >
              {r.date}
            </span>
          </div>
          {r.text && (
            <blockquote
              class="text-[0.9375rem] leading-relaxed text-[var(--color-text-muted)]"
              
            >
              „{r.text}"
            </blockquote>
          )}
          <figcaption class="mt-auto text-sm font-medium" >
            {r.author}
          </figcaption>
        </figure>
      ))}
    </div>

    {/* Atrybucja + link do profilu — wymóg TOS Google, NIE usuwać. */}
    <div class="mt-8">
      <a
        href={data.profileUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] transition-colors hover:text-[var(--color-text)]"
      >
        Zobacz wszystkie opinie w Google
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14 4h6v6" />
          <path d="M20 4 10 14" />
          <path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
        </svg>
      </a>
    </div>
  </div>
</section>
