---
import IconBadge from "../IconBadge.astro";
import { editAttrs } from "../../lib/edit";
import { balancedGrid } from "../../lib/grid";
import { sectionBg } from "../../lib/sections";
import type { TestimonialsData } from "../../content.config";

interface Props {
  data: TestimonialsData;
  editPath: string;
}
const { data, editPath } = Astro.props;
const grid = balancedGrid(data.items.length);
---

<section
  id={data.id}
  class:list={["border-b border-[var(--color-border)]", sectionBg(data.background)]}
  {...editAttrs(editPath)}
>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      {data.badge && <IconBadge icon={data.badge.icon} label={data.badge.label} tone={data.badge.tone} editPath={`${editPath}.badge.label`} />}
      <h2
        class="mt-4 font-serif text-[length:var(--text-fs-h2)] font-medium leading-tight tracking-tight"
        {...editAttrs(`${editPath}.title`)}
      >
        {data.title}
      </h2>
    </div>

    <div class:list={["mt-12 gap-4", grid.container]}>
      {data.items.map((t, i) => (
        <figure
          class:list={[
            "flex flex-col justify-between gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6",
            grid.item(i),
          ]}
          {...editAttrs(`${editPath}.items.${i}`)}
        >
          <blockquote class="text-[0.9375rem] leading-relaxed text-[var(--color-text-muted)]">
            {/* editAttrs na wewnętrznym spanie — ozdobne „" zostają POZA
                edytowalną wartością (inaczej każdy zapis doklejałby cudzysłowy) */}
            „<span {...editAttrs(`${editPath}.items.${i}.text`)} set:html={t.text} />"
          </blockquote>
          <figcaption class="text-sm font-medium">
            <span {...editAttrs(`${editPath}.items.${i}.author`)}>{t.author}</span>
            {t.role && (
              <span class="text-[var(--color-text-faint)]"> — {t.role}</span>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
